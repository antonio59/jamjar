# Copy to .env and fill in. All values are optional — the app runs with
# sensible defaults; YouTube search falls back to mock results without a key.

# Server
PORT=3001
NODE_ENV=development
# Production only — browser writes are locked to this origin
# ALLOWED_ORIGIN=https://jamjar.antoniosmith.xyz

# Storage
DB_PATH=./data/jamjar.db
DOWNLOAD_DIR=./downloads
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# Search — without a key the app serves built-in mock results
YOUTUBE_API_KEY=

# Clean-version AI check (optional) — TypeSafe judges unlabelled titles that
# regexes can't call. Without a key, label rules run alone and nothing breaks.
TYPESAFE_API_KEY=
# Noul probability below which an unlabelled music result is hidden / a
# request rejected (0–1, default 0.5)
# TYPESAFE_CLEAN_THRESHOLD=0.5

# Downloads
MAX_CONCURRENT_DOWNLOADS=2
# Optional — when unset the newest working yt-dlp on PATH/Homebrew is used.
# Set this if an older install shadows the good binary.
YTDLP_PATH=
# Optional cookies file for YouTube bot-detection (Netscape format)
# YTDLP_COOKIES_FILE=./cookies.txt

# Media access tokens (<audio src>, EventSource). Set in production or tokens
# are regenerated — invalidating open streams — on every restart.
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=300

# Logging — debug | info | warn | error
LOG_LEVEL=info

# First-run seed accounts (only read by `pnpm seed`)
PARENT_PIN=
CRISTINA_PIN=
ISABELLA_PIN=
